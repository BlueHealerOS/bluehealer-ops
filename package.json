{
  "name": "bluehealer-ops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Founders-only operations app for BlueHealer. Code only; no data lives in this repository.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "preview:e2e": "vite preview --outDir dist-e2e --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "npm run build:e2e && playwright test --trace off",
    "check:fixtures": "node scripts/check-repo-hygiene.mjs",
    "build:validators": "node scripts/build-validators.mjs",
    "check:validators": "node scripts/build-validators.mjs --check",
    "crm:schemas": "node scripts/crm/write-schemas.mjs"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.30.0",
    "@tanstack/react-query": "^5.108.2",
    "cytoscape": "3.35.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "8.20.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
