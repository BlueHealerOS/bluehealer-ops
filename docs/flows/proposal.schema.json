{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Triage proposals written by the 18:00 routine",
  "type": "object",
  "required": ["generated", "proposals"],
  "properties": {
    "generated": { "type": "string" },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["intakeId", "type", "title", "rationale"],
        "properties": {
          "intakeId": { "type": "integer" },
          "type": { "enum": ["task", "CRM interaction", "intel", "application opportunity", "answer bank update", "hub knowledge note", "discard"] },
          "title": { "type": "string", "maxLength": 200 },
          "owner": { "enum": ["Santiago", "Jay", "Both", "Unassigned"] },
          "contributionType": { "enum": ["Milestone", "Key result", "Application", "Fundraising follow-up", "Relationship", "Operations"] },
          "links": { "type": "array", "items": { "type": "string" } },
          "labels": { "type": "array", "items": { "type": "string" } },
          "due": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "rationale": { "type": "string", "maxLength": 300 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
