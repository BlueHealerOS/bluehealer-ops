{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intake-record.schema.json",
  "title": "Intake Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","message_id","run_id","received_at","submitter","channel","source_type","source_url","title","shared_text","note","attachments","domain","domain_source","category","summary","why_it_matters","sources","retrieval_status","sensitivity","confidence","duplicate_of","flags","proposed_actions","knowledge_updates","status"],
  "properties": {
    "id": {"type": "string", "pattern": "^ir-[0-9a-f]{10}$"},
    "message_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "received_at": {"type": "string", "minLength": 10},
    "submitter": {"type": "string", "minLength": 1},
    "channel": {"enum": ["share-sheet", "email-forward"]},
    "source_type": {"enum": ["instagram", "youtube", "linkedin", "web", "pdf", "image", "text"]},
    "source_url": {"type": ["string", "null"]},
    "title": {"type": "string"},
    "shared_text": {"type": "string"},
    "note": {"type": "string"},
    "attachments": {"type": "array", "items": {"type": "object", "required": ["name", "content_type"], "properties": {"name": {"type": "string"}, "content_type": {"type": "string"}}}},
    "domain": {"enum": ["bluehealer", "vector-control", "jhu", "personal", "unknown"]},
    "domain_source": {"enum": ["tag", "inferred"]},
    "category": {"enum": ["competitor", "market", "clinical-evidence", "regulatory", "reimbursement", "funding-application", "contact-relationship", "hiring", "tool-skill", "idea", "other"]},
    "summary": {"type": "string"},
    "why_it_matters": {"type": "string"},
    "sources": {"type": "array", "items": {"type": "string"}},
    "retrieval_status": {"enum": ["full", "partial", "blocked"]},
    "sensitivity": {"enum": ["open", "founders-only", "ip-flag"]},
    "confidence": {"enum": ["low", "medium", "high"]},
    "duplicate_of": {"type": ["string", "null"]},
    "flags": {"type": "array", "items": {"type": "string"}},
    "proposed_actions": {"type": "array", "items": {"$ref": "action-item.schema.json"}},
    "knowledge_updates": {"type": "array", "items": {"$ref": "knowledge-update.schema.json"}},
    "status": {"enum": ["new", "proposed", "reviewed", "flushed", "discarded"]}
  }
}
