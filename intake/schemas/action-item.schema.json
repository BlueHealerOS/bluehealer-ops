{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "action-item.schema.json",
  "title": "Action Item (shaped like a future work app task)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","title","domain","owner","suggested_due","priority","source_intake_id","rationale","status","sink_ref"],
  "properties": {
    "id": {"type": "string", "pattern": "^ai-[0-9a-f]{8}$"},
    "title": {"type": "string", "minLength": 3},
    "domain": {"enum": ["bluehealer", "vector-control", "jhu", "personal", "unknown"]},
    "owner": {"enum": ["santiago", "jay", "unassigned"]},
    "suggested_due": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "priority": {"enum": ["low", "medium", "high"]},
    "source_intake_id": {"type": "string", "pattern": "^ir-[0-9a-f]{10}$"},
    "rationale": {"type": "string"},
    "status": {"enum": ["proposed", "accepted", "rejected", "done"]},
    "sink_ref": {"type": ["string", "null"]}
  }
}
